# Nizamlar Baskı Next.js Storefront Ortam Değişkenleri Şablonu

# Medusa v2 Publishable API Key
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=your_publishable_api_key_here

# Medusa Backend URL
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Varsayılan Ülke/Bölge (tr: Türkiye)
NEXT_PUBLIC_DEFAULT_REGION=tr

# Mağaza Adresi
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Kurumsal Web Sitesi
NEXT_PUBLIC_NIZAMLAR_WEB_URL=https://nizamlarbaski.com

# Ortam
NODE_ENV=development

# Shopify Headless US Commerce (Server-Only Secrets + Feature Flag, Default: false)
NEXT_PUBLIC_DTF_SHOPIFY_ENABLED=false
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-10
