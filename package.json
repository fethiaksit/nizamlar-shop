{
  "name": "nizamlar-shop",
  "private": true,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "turbo seed --filter=@nizamlar/backend",
    "backend:dev": "turbo dev --filter=@nizamlar/backend",
    "storefront:dev": "turbo dev --filter=@nizamlar/storefront"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5",
      "tsconfig-paths": "^4.2.0"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.22.2",
    "ajv": "^8.13.0",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turbo": "^2.0.14"
  },
  "workspaces": [
    "apps/**",
    "!apps/backend/.medusa/**"
  ],
  "overrides": {
    "eslint": {
      "ajv": "^6.12.4"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.12.4"
    }
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@types/three": "^0.187.0",
    "framer-motion": "^14.9.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.67.0",
    "three": "^0.187.0"
  }
}
